---
import SiteFooter from '../components/SiteFooter.astro';
import AsciinemaCast from '../components/AsciinemaCast.astro';
const base = import.meta.env.BASE_URL;
const site = 'https://deblasis.github.io/zioscp-web';
const github = 'https://github.com/deblasis/zioscp';
const sponsor = 'https://github.com/sponsors/deblasis';
const quickstart = base + 'quickstart';
const benchmarks = base + 'reference/benchmarks';
const title = 'zioscp — faster, resumable, parallel scp over SSH';
const description =
	'A drop-in scp replacement in Zig. Resumable, parallel, pipelined transfers over SFTP. Works against any unmodified sshd. macOS, Linux, Windows.';
const ogImage = site + '/og.png';
const features = [
	{
		icon: 'resume',
		title: 'Resume, verified',
		body: 'A dropped connection used to mean starting a big transfer from zero. zioscp writes a <code>.zioscppart</code> sidecar as it goes and a per-chunk SHA-256 MAC, so a re-run continues where it stopped — and refuses to trust a partial that was corrupted on disk between runs.',
		proof: 'Detected in 42/42 battle tests, including a flipped byte mid-partial.',
	},
	{
		icon: 'parallel',
		title: 'Parallel, two ways',
		body: '<code>-r&nbsp;-j&nbsp;N</code> fans a whole tree across N connections at once; <code>-j&nbsp;N</code> on one large file shards it across N streams writing disjoint offset ranges. Many small files or one big file — both use the whole pipe.',
		proof: '~4.7× faster than <code>scp&nbsp;-r</code> at 100 ms RTT (100 files).',
	},
	{
		icon: 'pipeline',
		title: 'Pipelined to the BDP',
		body: 'Every stream keeps an adaptive, bandwidth-delay-product-sized window of SFTP requests in flight — sized from how long each ack actually blocks, not a fixed constant. So even <code>-j1</code> saturates the server and beats stock scp on large transfers.',
		proof: 'Single-stream upload and download both match or beat scp under latency.',
	},
];
const faqs = [
	{
		q: 'Does it need anything installed on the server?',
		a: 'No. zioscp speaks SFTP over any unmodified <code>sshd</code> — the subsystem every OpenSSH server ships with. There is no daemon to run and nothing to change on the host.',
	},
	{
		q: 'Is it really a drop-in for scp?',
		a: 'Yes. Same syntax and flags: <code>[user@]host:path</code>, <code>-r</code>, <code>-p</code>, <code>-P</code>, <code>-i</code>. Point it at the same paths you already use.',
	},
	{
		q: 'What about Windows?',
		a: 'First-class. The self-contained <code>libssh2</code> backend builds one binary with no <code>ssh</code>, <code>libssl</code>, or <code>libcrypto</code> dependency — it runs natively on macOS, Linux, and Windows.',
	},
	{
		q: 'Will my keys and host checks work?',
		a: 'Ed25519, ECDSA, and RSA public-key auth all work, plus the curve25519 key exchange. Server host keys are verified against <code>~/.ssh/known_hosts</code> by default, just like scp under BatchMode.',
	},
	{
		q: 'What is the license?',
		a: 'Dual MIT OR Apache-2.0 — pick either.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b1020" />
		<meta name="author" content="Alessandro De Blasis" />
		<link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
		<link rel="canonical" href={site + '/'} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />

		<!-- Open Graph / Twitter card. og.png is generated via assets/images.mjs. -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={site + '/'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="zioscp" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Structured data (SoftwareApplication) for rich search results. -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			name: "zioscp",
			applicationCategory: "DeveloperApplication",
			operatingSystem: "macOS, Linux, Windows",
			description: description,
			url: site + "/",
			downloadUrl: github,
			license: "https://github.com/deblasis/zioscp/blob/master/LICENSE-MIT",
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
		})} is:inline />
	</head>
	<body>
		<header class="topbar">
			<a class="brand" href={base} aria-label="zioscp home">
				<svg width="120" height="24" viewBox="0 0 150 32" fill="none" aria-hidden="true">
					<g font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="19" font-weight="600" letter-spacing="-0.02em">
						<text x="26" y="22" fill="currentColor">zio<tspan fill="#3b82f6">scp</tspan></text>
					</g>
					<path d="M5 16 L17 16 M12 10 L17 16 L12 22" stroke="#3b82f6" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</a>
			<nav>
				<a href={quickstart}>Docs</a>
				<a href={benchmarks}>Benchmarks</a>
				<a href={github} rel="noopener">GitHub</a>
				<a class="cta-sm" href={quickstart}>Get started</a>
			</nav>
		</header>

		<main>
			<!-- HERO -->
			<section class="hero" style={`--hero-bg-img:url('${base}hero-bg.webp')`}>
				<div class="wrap">
					<p class="eyebrow">Drop-in <code>scp</code> replacement · written in Zig</p>
					<h1>Move files over SSH.<br /><span class="accent">Fast, resumable, in parallel.</span></h1>
					<p class="lede">
						zioscp speaks SFTP, so an interrupted transfer picks up where it left off, a
						directory tree fans out across many connections, and every stream is pipelined to
						beat scp — against any unmodified sshd.
					</p>
					<div class="cta-row">
						<a class="cta" href={quickstart}>Get started</a>
						<a class="cta ghost" href={github} rel="noopener">View on GitHub</a>
					</div>
					<div class="term" aria-label="example usage">
						<div class="term-dots"><i></i><i></i><i></i></div>
						<pre><span class="prompt">$</span> zioscp -r -j4 ./deploy/ prod:/var/www/app/
<span class="muted">recursing 38 files across 4 connections · resumable · pipelined</span></pre>
					</div>
				</div>
			</section>

			<!-- PROOF STRIP -->
			<section class="proof">
				<div class="wrap proof-grid">
					<div><strong>~4.7×</strong><span>faster than <code>scp -r</code> at 100 ms RTT</span></div>
					<div><strong>Resume</strong><span>any interrupted transfer, MAC-verified</span></div>
					<div><strong>Self-contained</strong><span>no ssh, libssl, or libcrypto needed</span></div>
					<div><strong>3 platforms</strong><span>macOS · Linux · Windows</span></div>
				</div>
			</section>

			<!-- PROBLEM -->
			<section class="section">
				<div class="wrap narrow">
					<h2>scp was built for a simpler network.</h2>
					<p>
						A single dropped connection restarts the whole file. One stream can't fill a fat
						or long-latency pipe. Recursive copies are chatty, waiting on each file in turn.
						You shouldn't have to choose between <em>fast</em>, <em>reliable</em>, and
						<em>standard</em>.
					</p>
				</div>
			</section>

			<!-- HOW IT WORKS -->
			<section class="section features">
				<div class="wrap">
					<h2 class="center">Three things scp can't do</h2>
					<div class="feature-grid">
						{features.map((f) => (
							<article class="feature">
								<div class="feature-icon" aria-hidden="true">
									{f.icon === 'resume' && (
										<svg viewBox="0 0 24 24" fill="none"><path d="M12 4v8l5 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/></svg>
									)}
									{f.icon === 'parallel' && (
										<svg viewBox="0 0 24 24" fill="none"><path d="M4 7h7M4 12h11M4 17h7M16 7l3 3-3 3M16 12h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
									)}
									{f.icon === 'pipeline' && (
										<svg viewBox="0 0 24 24" fill="none"><path d="M3 12h4l2-5 4 10 2-5h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
									)}
								</div>
								<h3 set:html={f.title}></h3>
								<p set:html={f.body}></p>
								<p class="proof-line" set:html={f.proof}></p>
							</article>
						))}
					</div>
					<p class="read-more"><a href={benchmarks}>See the benchmark numbers →</a></p>
				</div>
			</section>

			<!-- SEE IT IN ACTION -->
			<section class="section demo-section">
				<div class="wrap">
					<h2 class="center">Watch it beat scp</h2>
					<p class="center lede">
						Same 20 files over a 100 ms-RTT link: <code>scp -r</code> crawls, while
						<code>zioscp -r -j4</code> flies and shows you everything. (Real recording.)
					</p>
					<div class="demo-wrap">
						<AsciinemaCast src={base + 'casts/s4-vs-scp.cast'} cols={100} rows={26} />
					</div>
					<p class="center read-more"><a href={base + 'demos'}>More demos →</a></p>
				</div>
			</section>

			<!-- FAQ -->
			<section class="section faq">
				<div class="wrap narrow">
					<h2 class="center">Questions</h2>
					{faqs.map((f) => (
						<details>
							<summary set:html={f.q}></summary>
							<p set:html={f.a}></p>
						</details>
					))}
				</div>
			</section>

			<!-- CLOSING CTA -->
			<section class="cta-section">
				<div class="wrap center">
					<h2>Stop restarting transfers.</h2>
					<p>Same flags as scp. Faster, resumable, parallel. Nothing to install on the server.</p>
					<a class="cta big" href={quickstart}>Get started</a>
				</div>
			</section>
		</main>

		<SiteFooter />
	</body>
</html>

<style is:global>
	:root {
		--bg: #ffffff;
		--ink: #0e1320;
		--muted: #5b6678;
		--line: #e7eaf0;
		--accent: #3b82f6;
		--accent-ink: #1d4ed8;
		--hero-bg: #0b1020;
		--hero-ink: #e6eaf2;
		--hero-muted: #93a0b8;
		--code-bg: #0f1626;
	}
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body {
		margin: 0;
		font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		color: var(--ink);
		background: var(--bg);
		-webkit-font-smoothing: antialiased;
	}
	code, pre {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	}
	.wrap { max-width: 64rem; margin: 0 auto; padding: 0 1.5rem; }
	.wrap.narrow { max-width: 46rem; }
	.center { text-align: center; }

	/* Top bar */
	.topbar {
		display: flex; align-items: center; justify-content: space-between;
		padding: 0.9rem 1.5rem; border-bottom: 1px solid var(--line);
		position: sticky; top: 0; background: rgba(255,255,255,0.85);
		backdrop-filter: saturate(140%) blur(8px); z-index: 10;
	}
	.topbar nav { display: flex; align-items: center; gap: 1.1rem; }
	.topbar nav a { color: var(--muted); text-decoration: none; font-size: 0.92rem; }
	.topbar nav a:hover { color: var(--ink); }
	.brand { color: var(--ink); }
	.cta-sm {
		background: var(--accent); color: #fff !important; padding: 0.4rem 0.8rem;
		border-radius: 7px; font-weight: 600;
	}
	.cta-sm:hover { background: var(--accent-ink); }

	/* Hero */
	.hero {
		background:
			linear-gradient(rgba(11, 16, 32, 0.82), rgba(11, 16, 32, 0.93)),
			var(--hero-bg-img) center / cover no-repeat,
			var(--hero-bg);
		color: var(--hero-ink);
		padding: 4.5rem 0 4rem;
	}
	.hero .wrap { display: flex; flex-direction: column; align-items: flex-start; }
	.eyebrow {
		font-size: 0.82rem; letter-spacing: 0.04em; color: var(--hero-muted);
		margin: 0 0 1rem; font-family: ui-monospace, Menlo, monospace;
	}
	.hero h1 {
		font-size: clamp(2.1rem, 5.5vw, 3.4rem); line-height: 1.05; margin: 0 0 1rem;
		font-weight: 750; letter-spacing: -0.02em;
	}
	.hero .accent { color: #93c5fd; }
	.lede { font-size: 1.1rem; color: var(--hero-muted); max-width: 40rem; margin: 0 0 1.6rem; line-height: 1.6; }
	.cta-row { display: flex; gap: 0.8rem; margin-bottom: 2rem; flex-wrap: wrap; }
	.cta {
		background: var(--accent); color: #fff; text-decoration: none; font-weight: 650;
		padding: 0.7rem 1.2rem; border-radius: 8px; font-size: 0.98rem;
	}
	.cta:hover { background: var(--accent-ink); }
	.cta.ghost { background: transparent; color: var(--hero-ink); border: 1px solid #2a3349; }
	.cta.ghost:hover { border-color: #3b82f6; }
	.cta.big { display: inline-block; margin-top: 0.5rem; padding: 0.85rem 1.6rem; font-size: 1.05rem; }

	.term {
		background: var(--code-bg); border: 1px solid #1c2740; border-radius: 10px;
		width: 100%; max-width: 44rem; overflow: hidden;
	}
	.term-dots { display: flex; gap: 0.4rem; padding: 0.6rem 0.8rem 0; }
	.term-dots i { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: #2a3349; display: inline-block; }
	.term pre { margin: 0.4rem 0 0; padding: 0.6rem 1rem 1rem; color: #d7def0; font-size: 0.86rem; line-height: 1.7; }
	.prompt { color: #60a5fa; }
	.muted { color: #5f6b85; }

	/* Proof strip */
	.proof { border-bottom: 1px solid var(--line); background: #f7f8fb; }
	.proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; padding-top: 1.8rem; padding-bottom: 1.8rem; }
	.proof-grid > div { display: flex; flex-direction: column; gap: 0.15rem; }
	.proof-grid strong { font-size: 1.15rem; color: var(--ink); }
	.proof-grid span { font-size: 0.8rem; color: var(--muted); }

	/* Sections */
	.section { padding: 3.5rem 0; }
	.section h2 { font-size: 1.7rem; letter-spacing: -0.01em; margin: 0 0 1rem; font-weight: 700; }
	.section p { color: var(--muted); line-height: 1.7; }
	.feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 1.6rem; }
	.feature { border: 1px solid var(--line); border-radius: 12px; padding: 1.5rem; background: #fff; }
	.feature h3 { margin: 0.6rem 0 0.5rem; font-size: 1.1rem; }
	.feature p { font-size: 0.92rem; margin: 0 0 0.6rem; }
	.feature-icon { width: 2rem; height: 2rem; color: var(--accent); }
	.feature-icon svg { width: 100%; height: 100%; }
	.proof-line { font-size: 0.82rem !important; color: var(--accent-ink) !important; }
	.read-more { text-align: center; margin-top: 1.8rem; }
	.read-more a { color: var(--accent-ink); }
	.demo-section { background: #f7f8fb; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
	.demo-section .lede { color: var(--muted); max-width: 40rem; margin: 0 auto 0.5rem; }
	.demo-wrap { max-width: 50rem; margin: 1.8rem auto 0; }

	.faq details { border-bottom: 1px solid var(--line); padding: 0.8rem 0; }
	.faq summary { cursor: pointer; font-weight: 600; color: var(--ink); }
	.faq p { margin: 0.6rem 0 0; }

	.cta-section { background: var(--hero-bg); color: var(--hero-ink); padding: 4rem 0; }
	.cta-section h2 { color: #fff; font-size: 1.9rem; }
	.cta-section p { color: var(--hero-muted); }

	@media (max-width: 760px) {
		.proof-grid { grid-template-columns: repeat(2, 1fr); }
		.feature-grid { grid-template-columns: 1fr; }
		.topbar nav a:not(.cta-sm) { display: none; }
	}
</style>
